    {
      "name": "Import & Questions",
      "item": [
        {
          "name": "Import Questions",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"rawJson\": [\n    {\n      \"question_text\": \"What is 2 + 2?\",\n      \"question_type\": \"MCQ\",\n      \"marks\": 1,\n      \"difficulty\": \"easy\",\n      \"bloom_level\": \"Remember\",\n      \"explanation\": \"Basic arithmetic.\",\n      \"options\": [\n        { \"key\": \"A\", \"text\": \"3\" },\n        { \"key\": \"B\", \"text\": \"4\" },\n        { \"key\": \"C\", \"text\": \"5\" },\n        { \"key\": \"D\", \"text\": \"6\" }\n      ],\n      \"correct_option\": \"B\"\n    }\n  ],\n  \"mode\": \"append\"\n}"
            },
            "url": { "raw": "{{base_url}}/batches/{{batch_id}}/import", "host": ["{{base_url}}"], "path": ["batches", "{{batch_id}}", "import"] }
          }
        },
        {
