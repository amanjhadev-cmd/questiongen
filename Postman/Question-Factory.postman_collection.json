              "raw": "{{base_url}}/prompts?subjectId=&page=1&limit=20",
              "host": ["{{base_url}}"], "path": ["prompts"],
              "query": [
                { "key": "subjectId", "value": "" },
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "20" }
              ]
            }
          }
        },
        {
          "name": "Get Prompt",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/prompts/{{prompt_id}}", "host": ["{{base_url}}"], "path": ["prompts", "{{prompt_id}}"] }
          }
        },
        {
          "name": "List Prompt Versions",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/prompts/{{prompt_id}}/versions", "host": ["{{base_url}}"], "path": ["prompts", "{{prompt_id}}", "versions"] }
          }
        },
        {
          "name": "Get Prompt Version",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/prompts/{{prompt_id}}/versions/{{prompt_version_id}}", "host": ["{{base_url}}"], "path": ["prompts", "{{prompt_id}}", "versions", "{{prompt_version_id}}"] }
          }
        },
        {
          "name": "Create Prompt",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var res = pm.response.json();",
                  "if (res.id) pm.collectionVariables.set('prompt_id', res.id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Science MCQ Prompt\",\n  \"subjectId\": \"{{subject_id}}\",\n  \"description\": \"Generates MCQ questions for science subjects\"\n}"
            },
            "url": { "raw": "{{base_url}}/prompts", "host": ["{{base_url}}"], "path": ["prompts"] }
          }
        },
        {
          "name": "Add Prompt Version",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var res = pm.response.json();",
                  "if (res.id) pm.collectionVariables.set('prompt_version_id', res.id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"content\": \"Generate {{questionCount}} {{questionType}} questions for: {{topic}}. Difficulty: {{difficulty}}.\",\n  \"notes\": \"Initial version\"\n}"
            },
            "url": { "raw": "{{base_url}}/prompts/{{prompt_id}}/versions", "host": ["{{base_url}}"], "path": ["prompts", "{{prompt_id}}", "versions"] }
          }
        },
