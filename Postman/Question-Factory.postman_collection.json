            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"status\": \"published\"\n}" },
            "url": { "raw": "{{base_url}}/prompts/{{prompt_id}}/versions/{{prompt_version_id}}/status", "host": ["{{base_url}}"], "path": ["prompts", "{{prompt_id}}", "versions", "{{prompt_version_id}}", "status"] }
          }
        },
