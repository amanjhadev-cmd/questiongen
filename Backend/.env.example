NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://questiongen:questiongen_dev@localhost:5432/questiongen_db

JWT_SECRET=change-this-to-a-random-32-char-string-in-production
JWT_REFRESH_SECRET=change-this-to-another-random-32-char-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your_r2_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret
R2_BUCKET_NAME=questiongen
R2_PUBLIC_URL=https://assets.yourdomain.com

N8N_WEBHOOK_URL=https://n8n.yourdomain.com/webhook/your-id
N8N_SECRET_HEADER=your-n8n-shared-secret

FRONTEND_URL=http://localhost:3000
